@article{relyeaAssetBasedImplementationStructured2025,
  title = {Asset-{{Based Implementation}} of {{Structured Adaptations}} in an {{Online Third-Grade Content Literacy Intervention}}},
  author = {Relyea, Jackie E. and Gilbert, Joshua B. and Burkhauser, Mary and Scherer, Ethan and Mosher, Douglas M. and Wei, Zhongyu and Tvedt, Johanna and Kim, James S.},
  year = {2025},
  journal = {Reading Research Quarterly},
